# Base de données
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/hospital-elyon?retryWrites=true&w=majority
DB_NAME=hospital-elyon

# JWT
JWT_SECRET=change-this-secret-key-in-production
JWT_EXPIRE=24h

# Serveur
PORT=5000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost,file://

# Logging
LOG_LEVEL=info

# Email (optionnel)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-password

# API Externe
API_TIMEOUT=5000

# Tarifs (constants)
TARIF_STANDARD=10000
TARIF_INDIVIDUELLE=23000
TARIF_COMMUNE=8000
TARIF_VIP=35000
TARIF_REANIMATION=100000
TARIF_PEDIATRIE=12000
TARIF_URGENCE=15000
